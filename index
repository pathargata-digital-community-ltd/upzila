            // Cloudinary থেকে ছবিগুলো ডিলিট করার লজিক
            const snap = await get(ref(db, 'contest_participants'));
            if(snap.exists()) {
                const participants = snap.val();
                const deletePromises = [];
                
                // সব প্রতিযোগীর ছবিগুলো Cloudinary থেকে ডিলিট করার রিকোয়েস্ট পাঠানো
                Object.values(participants).forEach(p => {
                    if(p.image) {
