    window.sendAdminReply = () => {
        const uid = document.getElementById('active-chat-uid').value;
        const text = document.getElementById('chat-input').value.trim();
        if(!uid || !text) return;
        
        const chatId = auth.currentUser.uid < uid ? `${auth.currentUser.uid}_${uid}` : `${uid}_${auth.currentUser.uid}`;
        const encText = window.encryptMsg(text);
        const ts = Date.now();
        
        push(ref(db, `chats/${chatId}`), { sender: auth.currentUser.uid, text: encText, timestamp: ts });
        
        const adminName = "Admin Support"; 
        const userName = document.getElementById('chat-active-user').innerText.replace('Profile', '').trim();
        
        update(ref(db, `user_chats/${auth.currentUser.uid}/${uid}`), { name: userName, lastMessage: "You: " + encText, timestamp: ts });
        update(ref(db, `user_chats/${uid}/${auth.currentUser.uid}`), { name: adminName, lastMessage: encText, timestamp: ts });
        
        document.getElementById('chat-input').value = '';
