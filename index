    window.openAdminChat = (uid, name) => {
        document.getElementById('active-chat-uid').value = uid;
        document.getElementById('chat-active-user').innerHTML = `<span>${name}</span> <button onclick="viewUserDetails('${uid}')" class="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded">Profile</button>`;
        const chatId = auth.currentUser.uid < uid ? `${auth.currentUser.uid}_${uid}` : `${uid}_${auth.currentUser.uid}`;
        
        onValue(ref(db, `chats/${chatId}`), snap => {
            const container = document.getElementById('chat-messages');
            const msgs = snap.val() || {};
            if(Object.keys(msgs).length === 0) {
                container.innerHTML = '<p class="text-center text-gray-400 mt-10">কোনো মেসেজ নেই</p>';
                return;
            }
            container.innerHTML = Object.values(msgs).map(m => {
                const isMe = m.sender === auth.currentUser.uid;
                let text = m.text ? window.decryptMsg(m.text) : '';
                let img = m.image ? `<img src="${m.image}" class="max-w-[200px] rounded mt-1 cursor-pointer" onclick="window.open('${m.image}')">` : '';
                return `<div class="chat-bubble ${isMe ? 'chat-admin' : 'chat-user'} shadow-sm">${text} ${img}</div>`;
            }).join('');
            setTimeout(() => { container.scrollTop = container.scrollHeight; }, 100);
        });
