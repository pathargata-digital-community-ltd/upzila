            if(snap.exists()) {
                await set(ref(db, `posts/${id}`), snap.val().data);
                await remove(ref(db, `trash_bin/${id}`));
                alert("পোস্ট রিস্টোর করা হয়েছে!");
            }
        } catch(e) {
            alert("রিস্টোর করতে সমস্যা: " + e.message);
        }
    };

    window.permanentDeleteTrash = async (id) => {
        if(!confirm("আপনি কি নিশ্চিত যে পোস্টটি চিরতরে মুছে ফেলতে চান? এতে যুক্ত ছবিও Cloudinary থেকে মুছে যাবে।")) return;
        try {
            const snap = await get(ref(db, `trash_bin/${id}`));
            if(snap.exists()) {
                const p = snap.val().data;
                // Delete image logic
                if(p.image) await deleteFromCloudinary(p.image, (p.mediaType === 'video' || p.image.includes('.mp4')) ? 'video' : 'image');
                if(p.images && Array.isArray(p.images)) {
                    for(let img of p.images) await deleteFromCloudinary(img, img.includes('.mp4') ? 'video' : 'image');
                }
                if(p.audio || p.voice || p.audioUrl) await deleteFromCloudinary(p.audio || p.voice || p.audioUrl, 'video');

                await remove(ref(db, `trash_bin/${id}`));
                alert("পোস্টটি চিরতরে মুছে ফেলা হয়েছে!");
            }
        } catch(e) {
            alert("মুছে ফেলতে সমস্যা: " + e.message);
        }
    };

