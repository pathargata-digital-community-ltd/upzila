    window.loadChatList = () => {
        if(!auth.currentUser) return;
        onValue(ref(db, `user_chats/${auth.currentUser.uid}`), snap => {
            const list = document.getElementById('chat-user-list');
            const data = snap.val() || {};
            if(Object.keys(data).length===0) { list.innerHTML = '<p class="text-center text-gray-400 mt-4 text-sm">কোনো চ্যাট নেই</p>'; return; }
            
            list.innerHTML = Object.entries(data).sort((a,b)=>b[1].timestamp - a[1].timestamp).map(([uid, info]) => {
                let msg = info.lastMessage || '';
                if(!msg.includes("📷")) {
                    let prefix = msg.startsWith("You: ") ? "You: " : "";
                    let raw = msg.replace("You: ", "");
                    msg = prefix + window.decryptMsg(raw);
                }
                return `<div onclick="openAdminChat('${uid}', '${info.name.replace(/'/g, "\\'")}')" class="p-3 bg-white border-b cursor-pointer hover:bg-blue-50 transition rounded-lg mx-1 mb-1">
                    <b class="text-sm text-gray-800">${info.name}</b>
                    <p class="text-[11px] text-gray-500 truncate mt-0.5">${msg}</p>
                </div>`;
            }).join('');
        });
