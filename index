            complaints: document.getElementById('perm-complaints').checked,
        };
        update(ref(db, `users/${uid}/permissions`), permissions).then(() => {
            alert("পারমিশন সেভ করা হয়েছে!");
            closeModal('modal-permissions');
        });
    };

    // --- ONESIGNAL PUSH NOTIFICATION SENDER ---
    window.sendOneSignalNotification = async () => {
        const title = document.getElementById('onesignal-title').value.trim();
        const message = document.getElementById('onesignal-msg').value.trim();
        const imageUrl = document.getElementById('onesignal-image').value.trim();
        const appId = document.getElementById('onesignal-app-id').value.trim();
        const restApiKey = document.getElementById('onesignal-rest-api').value.trim();

        if (!title || !message) return alert("শিরোনাম এবং মেসেজ দিতে হবে!");
        if (!appId || !restApiKey) return alert("OneSignal App ID এবং REST API Key দিতে হবে!");

        const btn = document.getElementById('btn-send-onesignal');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> পাঠানো হচ্ছে...';
        btn.disabled = true;

        const payload = {
            app_id: appId,
            included_segments: ["Subscribed Users"], // এটি সকল ইউজারকে পাঠাবে
            headings: { "en": title },
            contents: { "en": message }
        };

        if (imageUrl) {
            payload.big_picture = imageUrl; // Android এর জন্য বড় ছবি
            payload.ios_attachments = { "id1": imageUrl }; // iOS এর জন্য
        }

        try {
            const response = await fetch("https://onesignal.com/api/v1/notifications", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": `Basic ${restApiKey}`
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (data.id) {
                alert("নোটিফিকেশন সফলভাবে পাঠানো হয়েছে!");
                document.getElementById('onesignal-title').value = "";
                document.getElementById('onesignal-msg').value = "";
                document.getElementById('onesignal-image').value = "";
                
                // Save Keys to Firebase Admin Settings for future use
                update(ref(db, 'admin_settings/onesignal_keys'), {
                    app_id: appId,
                    rest_api_key: restApiKey
                });
            } else {
                throw new Error(JSON.stringify(data.errors));
            }
        } catch (error) {
            console.error("OneSignal Error:", error);
            alert("নোটিফিকেশন পাঠানো যায়নি: " + error.message);
        } finally {
            btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> নোটিফিকেশন পাঠান';
            btn.disabled = false;
        }
    };

    // Load saved OneSignal keys when admin logs in
    onValue(ref(db, 'admin_settings/onesignal_keys'), (snap) => {
        if (snap.exists()) {
            const keys = snap.val();
            document.getElementById('onesignal-app-id').value = keys.app_id || '';
            document.getElementById('onesignal-rest-api').value = keys.rest_api_key || '';
        }
    });

    window.openModal = (id) => { const m = document.getElementById(id); m.classList.remove('hidden-custom'); void m.offsetWidth; m.classList.remove('opacity-0', 'pointer-events-none'); m.classList.add('open'); }
    window.closeModal = (id) => { const m = document.getElementById(id); m.classList.remove('open'); m.classList.add('opacity-0', 'pointer-events-none'); setTimeout(() => m.classList.add('hidden-custom'), 300); }
    window.toggleSidebar = () => { const sidebar = document.getElementById('main-sidebar'); sidebar.classList.toggle('collapsed'); sidebar.classList.toggle('w-64'); };

</script>

<script>
    function switchTab(id) {
        // নতুন 'tracking' ট্যাব যুক্ত করা হলো
        const tabs =['dashboard','locations','services','notices', 'notes_mod', 'directory','users','verified_users', 'chat', 'posts','complaints','push_notifications','market', 'blood', 'verification', 'reports', 'settings', 'emergency', 'monetization', 'ads', 'transport', 'contest', 'outside-nid', 'tourists', 'account-delete', 'trash', 'tracking'];
        tabs.forEach(t => {
            const el = document.getElementById('tab-'+t);
            const menu = document.getElementById('menu-'+t);
            if(el) el.classList.add('hidden-custom');
            if(menu) {
                menu.classList.remove('active', 'bg-green-100', 'text-green-700', 'bg-pink-100', 'text-pink-700', 'bg-orange-100', 'text-orange-700');
            }
        });
        
        const target = document.getElementById('tab-'+id);
        const targetMenu = document.getElementById('menu-'+id);
        if(target) target.classList.remove('hidden-custom');
        
        if(targetMenu) {
            if(id === 'trash') {
                targetMenu.classList.add('active', 'bg-orange-100', 'text-orange-700');
            } else if (id === 'notes_mod') {
                targetMenu.classList.add('active', 'bg-pink-100', 'text-pink-700');
            } else {
                targetMenu.classList.add('active', 'bg-green-100', 'text-green-700');
            }
        }
    }
</script>

