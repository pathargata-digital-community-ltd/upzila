            get(query(ref(db, 'complaints'), limitToLast(5))),
            get(query(ref(db, 'verification_requests'), limitToLast(5)))
        ];

        Promise.all(promises).then(([usersSnap, postsSnap, compSnap, verifySnap]) => {
            let activities =[];

            usersSnap.forEach(c => {
                const u = c.val(); checkForSecurityThreats(u);
                const time = u.joinedAt ? new Date(u.joinedAt).getTime() : getTimestampFromId(c.key);
                activities.push({ type: 'User', icon: 'fa-user-plus', color: 'bg-green-100 text-green-600', desc: `<span class="font-bold cursor-pointer hover:underline text-blue-600" onclick="viewUserDetails('${c.key}')">${u.name || 'Unknown'}</span> joined`, time: time, action: `<button onclick="switchTab('users')" class="text-blue-600 text-xs font-bold hover:underline">View</button>` });
            });

            postsSnap.forEach(c => {
                const p = c.val();
                activities.push({ type: 'Post', icon: 'fa-newspaper', color: 'bg-blue-100 text-blue-600', desc: `<span class="font-bold cursor-pointer hover:underline text-blue-600" onclick="viewUserDetails('${p.uid || p.authorId || p.userId}')">${p.author || 'User'}</span> posted: "${(p.content || 'Media').substring(0, 30)}..."`, time: p.timestamp || getTimestampFromId(c.key), action: `<button onclick="switchTab('posts')" class="text-blue-600 text-xs font-bold hover:underline">Check</button>` });
            });

            compSnap.forEach(c => {
                const co = c.val();
                activities.push({ type: 'Complaint', icon: 'fa-circle-exclamation', color: 'bg-red-100 text-red-600', desc: `New complaint regarding <span class="font-bold">${co.type || 'Issue'}</span>`, time: co.timestamp || getTimestampFromId(c.key), action: `<button onclick="switchTab('complaints')" class="text-blue-600 text-xs font-bold hover:underline">Resolve</button>` });
            });

            verifySnap.forEach(c => {
                const v = c.val();
                activities.push({ type: 'Verify', icon: 'fa-id-card', color: 'bg-yellow-100 text-yellow-600', desc: `Verification request from <span class="font-bold cursor-pointer hover:underline" onclick="viewUserDetails('${c.key}')">${v.name}</span>`, time: getTimestampFromId(c.key), action: `<button onclick="switchTab('verification')" class="text-blue-600 text-xs font-bold hover:underline">Review</button>` });
            });

            activities.sort((a, b) => b.time - a.time);
            container.innerHTML = '';
            if (activities.length === 0) { container.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-gray-400">কোনো সাম্প্রতিক অ্যাক্টিভিটি নেই</td></tr>'; return; }

            activities.slice(0, 10).forEach(act => {
                const dateStr = new Date(act.time).toLocaleString('bn-BD', { hour: 'numeric', minute: 'numeric', day: 'numeric', month: 'short' });
                container.innerHTML += `<tr class="hover:bg-gray-50 transition"><td class="pl-6 py-3"><div class="flex items-center gap-3"><div class="activity-icon ${act.color}"><i class="fa-solid ${act.icon}"></i></div><span class="text-xs font-bold text-gray-600">${act.type}</span></div></td><td class="py-3 text-sm text-gray-700">${act.desc}</td><td class="py-3 text-xs text-gray-400 font-mono">${dateStr}</td><td class="text-right pr-6">${act.action}</td></tr>`;
            });
        });
    };

    // ট্র্যাকিং লগ মুছে ফেলার ফাংশন (এডমিন সুবিধার্থে)
    window.clearTrackingLogs = () => {
        if(confirm("সতর্কতা: আপনি কি নিশ্চিত যে সমস্ত ট্র্যাকিং লগ ডেটাবেস থেকে ডিলিট করতে চান? এটি রিপোর্টের পুরনো ডাটা সম্পূর্ণ মুছে ফেলবে।")) {
            remove(ref(db, 'tracking'))
                .then(() => alert("সকল ট্র্যাকিং লগ সফলভাবে মুছে ফেলা হয়েছে!"))
                .catch(e => alert("ত্রুটি: " + e.message));
        }
    };
    
    // ১. ইউজারকে সরাসরি সতর্কবার্তা (Warning) পাঠানোর ফাংশন
    window.sendWarningToUser = (uid, name) => {
        const reason = prompt(`⚠️ ${name}-কে কি কারণে সতর্ক করতে চান? বিবরণ লিখুন:`);
        if(!reason || reason.trim() === '') return;
        
        const ts = Date.now();
        // ইউজারের নোটিফিকেশন নোডে সতর্কবার্তা পুশ করা হচ্ছে
        push(ref(db, `notifications/${uid}`), {
            type: 'warning',
            fromName: 'পাথরঘাটা ডিজিটাল সাপোর্ট',
            text: `⚠️ এডমিন সতর্কবার্তা: ${reason}`,
            timestamp: ts,
            read: false
        }).then(() => {
            alert(`সফল হয়েছে! ${name}-এর ফোনে সতর্কবার্তা পাঠানো হয়েছে।`);
            // অ্যাক্টিভিটি লগে এডমিনের এই অ্যাকশনটি রেকর্ড করে রাখা হচ্ছে
            if(typeof window.logUserActivity === 'function') {
                window.logUserActivity("Admin Warned User", { warned_uid: uid, reason: reason });
            }
        }).catch(err => alert("ত্রুটি: " + err.message));
    };

    // ২. ইউজারকে সরাসরি ব্লক/ডিঅ্যাক্টিভেট বা পুনরায় একটিভ করার ফাংশন
    window.toggleUserStatusFromLog = (uid, name) => {
        get(ref(db, `users/${uid}/status`)).then(snap => {
            const currentStatus = snap.val() || 'user';
            const isDeactivated = currentStatus === 'deactivated';
            
            const confirmMsg = isDeactivated 
                ? `আপনি কি ${name}-এর একাউন্টটি পুনরায় সচল (Activate) করতে চান?` 
                : `সতর্কতা: আপনি কি নিশ্চিত যে ${name}-কে ব্লক/ডিঅ্যাক্টিভেট করতে চান? এর ফলে ইউজার আর অ্যাপ ব্যবহার করতে পারবেন না।`;
            
            if(confirm(confirmMsg)) {
                const newStatus = isDeactivated ? 'user' : 'deactivated';
                update(ref(db, `users/${uid}`), { status: newStatus }).then(() => {
                    alert(`সফল হয়েছে! একাউন্টটি বর্তমানে ${isDeactivated ? 'সক্রিয় (Active)' : 'নিষ্ক্রিয় (Deactivated/Blocked)'} করা হয়েছে।`);
                    
                    // ট্র্যাকিং নোডে এই অ্যাকশনটি সেভ রাখা
                    if(typeof window.logUserActivity === 'function') {
                        window.logUserActivity(isDeactivated ? "Admin Activated User" : "Admin Blocked User", { target_uid: uid });
                    }
                }).catch(err => alert("ত্রুটি: " + err.message));
            }
        });
    };

    function loadData() {
        loadRecentActivity();

        // রিয়েল-টাইমে ফায়ারবেস থেকে শেষ ১০০টি ট্র্যাকিং লগ রিড করে টেবিলে দেখানো (Optimized for performance)
        onValue(query(ref(db, 'tracking'), limitToLast(100)), (snap) => {
            const list = document.getElementById('list-tracking');
            if(!snap.exists()) {
                list.innerHTML = '<tr><td colspan="6" class="text-center py-6 text-gray-400">কোনো অ্যাক্টিভিটি বা ট্র্যাকিং লগ পাওয়া যায়নি</td></tr>';
                return;
            }
            
            const logs = [];
            snap.forEach(child => {
                logs.push({ id: child.key, ...child.val() });
            });
            logs.reverse(); // নতুন নোটিফিকেশন/লগ উপরে দেখানোর জন্য

            list.innerHTML = logs.map(log => {
                let userCell = '';
                if(log.uid && log.uid !== 'guest_user') {
                    // ভেরিফাইড বা রেজিস্টার্ড ইউজার হলে তাঁর প্রোফাইল দেখার অপশন
                    userCell = `
                    <div class="flex items-center gap-2 cursor-pointer text-blue-600 hover:text-blue-800 transition font-bold" onclick="viewUserDetails('${log.uid}')">
                        <i class="fa-solid fa-user-circle"></i>
                        <span>${escapeHTML(log.userName)}</span>
                    </div>`;
                } else {
                    // গেস্ট ইউজার হলে কুকি ডিভাইস আইডি অনুযায়ী দেখাবে
                    userCell = `<span class="text-gray-400 italic"><i class="fa-solid fa-user-secret"></i> Guest / Visitor</span>`;
                }

                // অ্যাকশন ভেদে আলাদা ব্যাজ কালার
                let actionBadge = '';
                if(log.action === "Page Visit") {
                    actionBadge = `<span class="bg-blue-100 text-blue-700 text-xs px-2.5 py-1 rounded font-bold">${log.action}</span>`;
                } else if(log.action === "User Logout" || log.action.includes("Delete")) {
                    actionBadge = `<span class="bg-red-100 text-red-700 text-xs px-2.5 py-1 rounded font-bold">${log.action}</span>`;
                } else {
                    actionBadge = `<span class="bg-green-100 text-green-700 text-xs px-2.5 py-1 rounded font-bold">${log.action}</span>`;
                }

                // বিস্তারিত তথ্য স্ট্রিংফাই থেকে সুন্দর ফরম্যাটে রূপান্তর
                let detailsStr = '';
                if(log.details && typeof log.details === 'object') {
                    detailsStr = Object.entries(log.details).map(([k, v]) => `<span class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-600 border border-gray-200 mr-1">${k}: ${v}</span>`).join(' ');
                } else {
                    detailsStr = log.details || 'None';
                }

                // যদি ইউজার রেজিস্টার্ড হন, তবেই অ্যাকশন বাটনগুলো দেখাবে (গেস্টদের জন্য বাটন নিষ্ক্রিয় থাকবে)
                let controlButtons = `<span class="text-gray-400 italic text-xs">Guest User</span>`;
                if(log.uid && log.uid !== 'guest_user') {
                    const safeName = log.userName ? log.userName.replace(/'/g, "\\'") : 'User';
                    controlButtons = `
                    <div class="flex gap-1.5">
                        <button onclick="sendWarningToUser('${log.uid}', '${safeName}')" class="bg-yellow-50 hover:bg-yellow-500 hover:text-white text-yellow-600 px-2 py-1 rounded text-xs font-bold border border-yellow-200 transition" title="সতর্কবার্তা পাঠান"><i class="fa-solid fa-triangle-exclamation"></i> Warn</button>
                        <button onclick="toggleUserStatusFromLog('${log.uid}', '${safeName}')" class="bg-red-50 hover:bg-red-600 hover:text-white text-red-600 px-2 py-1 rounded text-xs font-bold border border-red-200 transition" title="ব্লক/ডিঅ্যাক্টিভেট করুন"><i class="fa-solid fa-ban"></i> Block</button>
                    </div>`;
                }

                return `
                <tr class="hover:bg-slate-50 transition">
                    <td class="pl-6 py-3.5 text-sm">${userCell}</td>
                    <td class="py-3.5 text-xs">
                        <span class="block font-bold text-gray-700">${escapeHTML(log.userUnion)}</span>
                        <span class="text-gray-400">${escapeHTML(log.userVillage)}</span>
                    </td>
                    <td class="py-3.5">${actionBadge}</td>
                    <td class="py-3.5 text-xs max-w-[200px] truncate" title="সম্পূর্ণ দেখতে কার্সার রাখুন">${detailsStr}</td>
                    <td class="py-3.5 text-xs font-mono text-gray-500">${log.timeString || new Date(log.timestamp).toLocaleString()}</td>
                    <td class="py-3.5 text-[10px] font-mono text-gray-400 select-all" title="কপি করতে ক্লিক করুন">${log.deviceId ? log.deviceId.substring(0, 10) + '...' : '-'}</td>
                    <td class="pr-6 py-3.5">${controlButtons}</td>
                </tr>`;
            }).join('');
        });

        // 24H NOTES (STORY) MODERATION
        onValue(ref(db, 'stories'), (snap) => {
            const data = snap.val() || {};
            const list = document.getElementById('list-notes_mod');
            if(Object.keys(data).length === 0) { list.innerHTML = '<p class="col-span-full text-center text-gray-400 py-10">কোনো স্টোরি নেই</p>'; return; }

            list.innerHTML = Object.entries(data).sort((a,b) => b[1].timestamp - a[1].timestamp).map(([storyId, story]) => {
                let mediaHtml = '';
                if(story.mediaUrl) {
                    if(story.mediaType === 'video') {
                        mediaHtml = `<video src="${story.mediaUrl}" class="w-full h-32 object-cover rounded mb-2 bg-black" controls></video>`;
                    } else {
                        mediaHtml = `<img src="${story.mediaUrl}" class="w-full h-32 object-cover rounded mb-2 cursor-pointer" onclick="window.open('${story.mediaUrl}')">`;
                    }
                }

                // চেক করবে স্টোরিটির মেয়াদ শেষ হয়েছে কি না
                const isExpired = (Date.now() - story.timestamp) > (24 * 60 * 60 * 1000);
                const expiredBadge = isExpired ? `<span class="absolute top-2 left-2 bg-red-600 text-white text-[10px] px-2 py-0.5 rounded animate-pulse z-10 shadow">Expired</span>` : '';

                return `
                <div class="bg-white p-3 rounded-xl shadow-sm border ${isExpired ? 'border-red-400 bg-red-50 opacity-80' : 'border-pink-100'} flex flex-col relative group hover:opacity-100 transition">
                    ${expiredBadge}
                    <button onclick="deleteSingleStory('${storyId}', '${story.mediaUrl || ''}', '${story.mediaType || ''}')" class="absolute top-2 right-2 text-red-500 hover:text-white hover:bg-red-500 bg-white rounded-full w-8 h-8 flex justify-center items-center opacity-0 group-hover:opacity-100 transition shadow z-10"><i class="fa-solid fa-trash text-xs"></i></button>
                    
                    <div class="flex items-center gap-2 mb-2 cursor-pointer" onclick="viewUserDetails('${story.uid}')">
                        <img src="${story.authorPic || 'https://via.placeholder.com/40'}" class="w-8 h-8 rounded-full object-cover border border-pink-200">
                        <span class="text-xs font-bold text-gray-800 truncate">${story.author || 'User'}</span>
                    </div>
                    
                    ${mediaHtml}
                    ${story.text ? `<p class="text-xs font-medium bg-gray-50 p-2 rounded flex-1 text-center text-gray-800 break-words">${escapeHTML(story.text)}</p>` : ''}
                    
                    <p class="text-[10px] text-gray-400 mt-2 text-center border-t pt-2">${new Date(story.timestamp).toLocaleString()}</p>
                </div>
                `;
            }).join('');
        });

        // LOCATIONS
        onValue(ref(db, 'locations'), (snap) => {
            const data = snap.val() || {};
            const div = document.getElementById('list-locations');
            div.innerHTML = '';
            
            Object.entries(data).forEach(([unionName, villages]) => {
                let vList = typeof villages === 'object' ? Object.values(villages) :[villages];
                div.innerHTML += `<div class="bg-white p-4 rounded shadow-sm border border-green-100"><h4 class="font-bold text-green-700">${unionName}</h4><p class="text-xs text-gray-500 mt-1">${vList.join(', ')}</p><button onclick="deleteItem('locations/${unionName}')" class="text-red-500 text-xs mt-2 border border-red-100 px-2 py-1 rounded hover:bg-red-50">Delete Union</button></div>`;
            });
        });

        // COMPLAINTS
        onValue(ref(db, 'complaints'), (snap) => {
            const data = snap.val() || {};
            allComplaints =[];
            const unionSet = new Set();
            
            Object.entries(data).forEach(([id, c]) => {
                allComplaints.push({ ...c, id });
                if(c.union) unionSet.add(c.union);
            });
            
            const compUnionSelect = document.getElementById('filter-comp-union');
            let options = '<option value="all">সকল ইউনিয়ন</option>';
            unionSet.forEach(u => options += `<option value="${u}">${u}</option>`);
            compUnionSelect.innerHTML = options;
            
            filterComplaints();
        });

        // VERIFICATION REQUESTS
        onValue(ref(db, 'verification_requests'), (snap) => {
            const data = snap.val() || {};
            const list = document.getElementById('list-verification');
            const badge = document.getElementById('badge-verify');
            
            const reqs = Object.entries(data);
            if(reqs.length === 0) {
                badge.classList.add('hidden');
                list.innerHTML = '<p class="text-gray-400 text-center py-10 col-span-2">কোনো ভেরিফিকেশন রিকোয়েস্ট নেই</p>';
                document.getElementById('count-verify').innerText = 0;
                return;
            }
            
            badge.innerText = reqs.length;
            badge.classList.remove('hidden');
            document.getElementById('count-verify').innerText = reqs.length;
            
            list.innerHTML = '';
            reqs.reverse().forEach(([uid, req]) => {
                list.innerHTML += `
                <div class="bg-white p-5 rounded-xl shadow-sm border border-blue-100 relative">
                    <div class="flex items-center gap-4 mb-4 border-b pb-3">
                        <img src="${req.userImage || req.profilePic || 'https://via.placeholder.com/60'}" class="w-14 h-14 rounded-full border-2 border-blue-100 object-cover">
                        <div>
                            <h4 class="font-bold text-gray-800 text-lg">${req.name}</h4>
                            <p class="text-xs text-gray-500"><i class="fa-solid fa-phone"></i> ${req.paymentNumber || req.phone || 'N/A'}</p>
                        </div>
                        <button onclick="viewUserDetails('${uid}')" class="ml-auto text-blue-600 bg-blue-50 px-3 py-1.5 rounded text-xs font-bold hover:bg-blue-100">Profile</button>
                    </div>
                    <div class="mb-4 bg-gray-50 p-3 rounded-lg border border-gray-200 text-sm space-y-1">
                        <p><b>Payment Method:</b> ${req.paymentMethod || 'N/A'}</p>
                        <p><b>TrxID:</b> <span class="text-green-700 font-mono font-bold">${req.trxId || 'N/A'}</span></p>
                        <p><b>NID নাম্বার:</b> <span class="text-blue-700 font-mono font-bold">${req.nid || 'N/A'}</span></p>
                        <p class="text-xs text-gray-500 mt-2 font-bold mb-1 border-t pt-2">NID কার্ডের ছবি:</p>
                        <img src="${req.docImage || req.nidImage}" class="w-full h-40 object-cover rounded border cursor-pointer hover:opacity-90 transition" onclick="window.open(this.src)" title="বড় করে দেখতে ক্লিক করুন">
                    </div>
                    <div class="flex gap-3">
                        <button onclick="approveVerification('${uid}', '${req.name}')" class="flex-1 bg-green-600 text-white py-2.5 rounded-lg font-bold text-sm hover:bg-green-700 transition shadow-sm"><i class="fa-solid fa-check mr-1"></i> Approve</button>
                        <button onclick="rejectVerification('${uid}')" class="flex-1 bg-red-100 text-red-600 py-2.5 rounded-lg font-bold text-sm hover:bg-red-200 transition"><i class="fa-solid fa-xmark mr-1"></i> Reject</button>
                    </div>
                </div>`;
            });
        });

        // ACCOUNT DELETION REQUESTS
        onValue(ref(db, 'account_deletion_requests'), (snap) => {
            const data = snap.val() || {};
            const list = document.getElementById('list-account-delete');
            const badge = document.getElementById('badge-account-delete');
            
            const reqs = Object.entries(data);
            if(reqs.length === 0) {
                badge.classList.add('hidden');
                list.innerHTML = '<p class="text-gray-400 text-center py-10 col-span-2">কোনো একাউন্ট ডিলিট রিকোয়েস্ট নেই</p>';
                return;
            }
            
            badge.innerText = reqs.length;
            badge.classList.remove('hidden');
            
            list.innerHTML = '';
            reqs.reverse().forEach(([uid, req]) => {
                const dateStr = req.timestamp ? new Date(req.timestamp).toLocaleString() : 'N/A';
                list.innerHTML += `
                <div class="bg-white p-5 rounded-xl shadow-sm border border-red-200 relative">
                    <div class="flex items-center gap-4 mb-4 border-b pb-3">
                        <img src="${req.profilePic || req.profile_pic || 'https://via.placeholder.com/60'}" class="w-14 h-14 rounded-full border-2 border-red-100 object-cover">
                        <div>
                            <h4 class="font-bold text-gray-800 text-lg">${req.name || 'Unknown User'}</h4>
                            <p class="text-xs text-gray-500"><i class="fa-solid fa-envelope"></i> ${req.email || 'N/A'} | <i class="fa-solid fa-phone"></i> ${req.phone || 'N/A'}</p>
                        </div>
                    </div>
                    <div class="mb-4 bg-red-50 p-3 rounded-lg border border-red-100 text-sm">
                        <p class="text-red-700"><strong>রিকোয়েস্টের সময়:</strong> ${dateStr}</p>
                        <p class="text-xs text-gray-600 mt-1">UID: <span class="font-mono">${uid}</span></p>
                    </div>
                    <div class="flex gap-3">
                        <button onclick="processAccountDeletion('${uid}', this)" class="flex-1 bg-red-600 text-white py-2.5 rounded-lg font-bold text-sm hover:bg-red-700 transition shadow-sm">
                            <i class="fa-solid fa-trash-can mr-1"></i> Permanent Delete
                        </button>
                        <button onclick="deleteItem('account_deletion_requests/${uid}')" class="bg-gray-100 text-gray-600 px-4 rounded-lg font-bold text-sm hover:bg-gray-200 transition">
                            Dismiss
                        </button>
                    </div>
                </div>`;
            });
        });

        // TRASH BIN (DELETED POSTS)
        onValue(ref(db, 'trash_bin'), (snap) => {
            const data = snap.val() || {};
            const list = document.getElementById('list-trash');
            const badge = document.getElementById('badge-trash');
