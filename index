    window.decryptMsg = (cipherText) => { 
        try {
            const bytes = CryptoJS.AES.decrypt(cipherText, SECRET_KEY);
            const originalText = bytes.toString(CryptoJS.enc.Utf8);
            return originalText || cipherText; 
        } catch(e) { return cipherText; }
    };

    function escapeHTML(str) {
        if (!str) return "";
        return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function checkForSecurityThreats(data) {
        if (!data) return;
        const stringified = JSON.stringify(data).toLowerCase();
        if (stringified.includes('<script>') || stringified.includes('javascript:') || stringified.includes('<iframe>') || stringified.includes('onload=')) {
            document.getElementById('security-alert').classList.remove('hidden-custom');
            console.error("SECURITY THREAT DETECTED IN DATA:", data);
        }
    }

    async function uploadMediaToCloudinary(file) {
        if (!file) return null;
        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', 'Pathargata digital'); 
        
        try {
            const res = await fetch('https://api.cloudinary.com/v1_1/dl1auoanl/auto/upload', { 
                method: 'POST', body: formData 
            });
            const data = await res.json();
            if (data.error) throw new Error(data.error.message);
            return data.secure_url;
        } catch (error) {
            console.error("Cloudinary Upload Error:", error);
            alert("ছবি আপলোড ব্যর্থ হয়েছে: " + error.message);
            return null;
        }
    }

    // --- PERMANENT DELETION (CLOUDINARY LOGIC) ---
    window.extractPublicIdFromCloudinaryUrl = (url) => {
        if(!url || !url.includes('cloudinary.com')) return null;
        const matches = url.match(/\/upload\/(?:v\d+\/)?([^\.]+)/);
        return matches ? matches[1] : null;
    };

    window.deleteFromCloudinary = async (url, resourceType = 'image', isStory = false) => {
        const publicId = extractPublicIdFromCloudinaryUrl(url);
        if(!publicId) return;

        // চেক করা হচ্ছে এটি স্টোরির ছবি/ভিডিও কি না। সেই অনুযায়ী API Key সিলেক্ট হবে।
        const cloudName = isStory ? STORY_CLOUDINARY_CLOUD_NAME : CLOUDINARY_CLOUD_NAME;
        const apiKey = isStory ? STORY_CLOUDINARY_API_KEY : CLOUDINARY_API_KEY;
        const apiSecret = isStory ? STORY_CLOUDINARY_API_SECRET : CLOUDINARY_API_SECRET;

        if(!apiKey || !apiSecret) return;

        // Generate SHA-1 Signature using CryptoJS
        const timestamp = Math.round((new Date).getTime() / 1000);
        const stringToSign = `public_id=${publicId}&timestamp=${timestamp}${apiSecret}`;
        const signature = CryptoJS.SHA1(stringToSign).toString();

        const formData = new URLSearchParams();
        formData.append('public_id', publicId);
        formData.append('timestamp', timestamp);
        formData.append('api_key', apiKey);
        formData.append('signature', signature);

        try {
            await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/${resourceType}/destroy`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            });
            console.log(`Cloudinary ${resourceType} deleted from ${isStory ? 'STORY' : 'MAIN'} account: ${publicId}`);
        } catch(e) {
            console.error("Cloudinary Delete Error: ", e);
        }
    };

    window.processAccountDeletion = async (uid, btnElement) => {
        if(!confirm("আপনি কি নিশ্চিত? ইউজারের সমস্ত ডাটা, পোস্ট এবং ক্লাউডিনারি ফাইল চিরতরে মুছে ফেলা হবে! এই অ্যাকশন আনডু করা যাবে না।")) return;

        const originalText = btnElement.innerHTML;
        btnElement.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Deleting...';
        btnElement.disabled = true;

        try {
            // 1. Fetch user profile (to delete profile_pic, cover_pic, etc.)
            const userSnap = await get(ref(db, `users/${uid}`));
            if(userSnap.exists()) {
                const user = userSnap.val();
                if(user.profile_pic) await deleteFromCloudinary(user.profile_pic, 'image');
                if(user.cover_pic) await deleteFromCloudinary(user.cover_pic, 'image');
                if(user.nid_url || user.nidImage || user.docImage) {
                    await deleteFromCloudinary(user.nid_url || user.nidImage || user.docImage, 'image');
                }
            }

            // 2. Fetch all user posts & delete media from Cloudinary
            const postsQuery = query(ref(db, 'posts'), orderByChild('uid'), equalTo(uid));
            const postsSnap = await get(postsQuery);
            const postIdsToDelete = [];

            if(postsSnap.exists()) {
                const deletePromises = [];
                postsSnap.forEach(child => {
                    postIdsToDelete.push(child.key);
                    const p = child.val();

                    if(p.image) deletePromises.push(deleteFromCloudinary(p.image, p.mediaType === 'video' || p.image.includes('.mp4') ? 'video' : 'image'));
                    if(p.images && Array.isArray(p.images)) {
                        p.images.forEach(img => {
                            deletePromises.push(deleteFromCloudinary(img, img.includes('.mp4') ? 'video' : 'image'));
                        });
                    }
                    if(p.audioUrl || p.audio || p.voice) {
                        deletePromises.push(deleteFromCloudinary(p.audioUrl || p.audio || p.voice, 'video')); 
                    }
                });
                await Promise.all(deletePromises);
            }

            // 3. Delete Firebase Realtime Database Data
            const updates = {};
            updates[`users/${uid}`] = null;
            updates[`user_chats/${uid}`] = null;
            updates[`account_deletion_requests/${uid}`] = null;
            updates[`monetization_requests/${uid}`] = null;
            updates[`withdraw_requests/${uid}`] = null;
            updates[`verification_requests/${uid}`] = null;
            
            postIdsToDelete.forEach(pid => {
                updates[`posts/${pid}`] = null;
            });

            // 4. Clean Anti-Fraud Data (Remove from registered_devices)
            const devQuery = query(ref(db, 'registered_devices'), orderByChild('uid'), equalTo(uid));
            const devSnap = await get(devQuery);
            if(devSnap.exists()) {
                devSnap.forEach(child => {
                    updates[`registered_devices/${child.key}`] = null;
                });
            }

            await update(ref(db), updates);

            alert("একাউন্ট এবং সমস্ত ডাটা সফলভাবে মুছে ফেলা হয়েছে!");
        } catch(error) {
            console.error(error);
            alert("ত্রুটি: " + error.message);
            btnElement.innerHTML = originalText;
            btnElement.disabled = false;
        }
    };


