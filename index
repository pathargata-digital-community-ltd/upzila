    function createPostHTML(p, showActions = true) {
        let imgDisplay = '';
        const images = p.images || (p.image ?[p.image] :[]);
        if (images.length > 0) {
            if (p.mediaType === 'video' || images[0].endsWith('.mp4')) { 
                imgDisplay = `<video src="${images[0]}" controls class="w-full h-40 object-cover rounded mb-2 border bg-black"></video>`; 
            } else { 
                imgDisplay = `<div class="relative cursor-pointer" onclick="window.open('${images[0]}')"><img src="${images[0]}" class="w-full h-40 object-cover rounded mb-2 border hover:opacity-90">`; 
                if(images.length > 1) { imgDisplay += `<span class="absolute bottom-3 right-2 bg-black bg-opacity-60 text-white text-xs px-2 py-1 rounded shadow">+${images.length - 1} আরও</span>`; } 
                imgDisplay += `</div>`; 
            }
        }

        let audioDisplay = '';
        const aSrc = p.audioUrl || p.voice || p.audio;
        if (aSrc) {
            audioDisplay = `<audio controls src="${aSrc}" class="w-full mt-2 mb-2 h-10 outline-none"></audio>`;
        }

        const realLikes = p.likes ? Object.keys(p.likes).length : 0;
        const likeCount = p.likeCount ? Math.max(p.likeCount, realLikes) : realLikes;
        const commentCount = p.comments ? Object.keys(p.comments).length : (p.commentCount || 0);
        const postScore = p.score || p.algorithmicScore || 0;

        const statsDisplay = `
            <div class="flex gap-4 text-xs font-bold text-gray-500 mt-2 border-t border-gray-100 pt-2">
