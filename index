                <span class="flex items-center gap-1 ml-auto text-yellow-600"><i class="fa-solid fa-star"></i> স্কোর: ${postScore}</span>
            </div>`;

        let actionDisplay = '';
        if(showActions) {
            actionDisplay = `<div class="flex gap-2 mt-3"><button onclick="openEditPostModal('${p.id}')" class="flex-1 bg-blue-50 text-blue-600 py-1.5 rounded text-xs font-bold hover:bg-blue-100 transition"><i class="fa-solid fa-pen"></i> Edit / Score</button><button onclick="deleteItem('posts/${p.id}')" class="flex-1 bg-red-50 text-red-600 py-1.5 rounded text-xs font-bold hover:bg-red-100 transition"><i class="fa-solid fa-trash"></i> Delete</button></div>`;
        }

        return `
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col h-full hover:shadow-md transition">
            <div class="flex items-center gap-3 mb-3 cursor-pointer" onclick="viewUserDetails('${p.uid || p.authorId || p.userId || p.authorUid}')" title="ইউজারের প্রোফাইল দেখুন">
                ${p.authorPic ? `<img src="${p.authorPic}" class="w-10 h-10 rounded-full border object-cover">` : `<div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center font-bold text-gray-500">${p.author?p.author[0]:'U'}</div>`}
                <div>
                    <h4 class="font-bold text-sm text-gray-800 hover:text-blue-600 transition">${p.author || 'Unknown User'}</h4>
                    <p class="text-[10px] text-gray-400">${new Date(p.timestamp || Date.now()).toLocaleString()}</p>
                </div>
            </div>
            ${imgDisplay}
            ${audioDisplay}
            <p class="text-sm text-gray-700 bg-gray-50 p-3 rounded-lg mb-2 flex-1 break-words whitespace-pre-wrap">${p.content || ''}</p>
            ${statsDisplay}
            ${actionDisplay}
        </div>`;
    }

    window.loadRecentActivity = () => {
        const container = document.getElementById('activity-log-list');
        container.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-gray-400"><i class="fa-solid fa-spinner fa-spin"></i> তথ্য লোড হচ্ছে...</td></tr>';

